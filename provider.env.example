# Copy to provider.env and fill in. NEVER commit provider.env.
{{PROVIDER_KEY_ENV}}=sk-your-key-here
BACKEND_USER=you@example.com
BACKEND_PASS=change-me

# --- Official WhatsApp Cloud API (only for Mode B) ---
# Dashboard: https://developers.facebook.com/apps/<APP_ID>/whatsapp-business/wa-settings/
# Generate a long-lived token from a System User with whatsapp_business_messaging.
WHATSAPP_CLOUD_VERIFY_TOKEN=pick-any-long-random-string
WHATSAPP_CLOUD_WEBHOOK_PORT=8090
WHATSAPP_CLOUD_WEBHOOK_PATH=/whatsapp/webhook
WHATSAPP_CLOUD_PHONE_NUMBER_ID=000000000000000
WHATSAPP_CLOUD_APP_ID=0000000000000000
WHATSAPP_CLOUD_APP_SECRET=your-app-secret
WHATSAPP_CLOUD_WABA_ID=000000000000000
WHATSAPP_CLOUD_ACCESS_TOKEN=EAAG...
# Required: the Cloud adapter ignores WHATSAPP_ALLOWED_USERS. Either set this
# to true, or set WHATSAPP_CLOUD_ALLOWED_USERS=5511999999999,5511888888888
WHATSAPP_CLOUD_ALLOW_ALL_USERS=true
